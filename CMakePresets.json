{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64",
      "binaryDir": "${sourceDir}/out/build/x64",
      "installDir": "${sourceDir}/out/install/x64",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release"
    },
    {
      "name": "x64-relwithdebinfo",
      "configurePreset": "x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "x64-minsizerel",
      "configurePreset": "x64",
      "configuration": "MinSizeRel"
    }
  ]
}