if(NOT DEFINED SRC OR NOT DEFINED DST OR NOT DEFINED STAMP)
  message(FATAL_ERROR "copy_tree_once needs SRC, DST and STAMP")
endif()
if(EXISTS "${DST}/.stamp" AND EXISTS "${STAMP}")
  file(READ "${DST}/.stamp" copied)
  file(READ "${STAMP}" source)
  if(copied STREQUAL source)
    return()
  endif()
endif()
file(MAKE_DIRECTORY "${DST}")
file(COPY "${SRC}/" DESTINATION "${DST}")
if(EXISTS "${STAMP}")
  file(READ "${STAMP}" source)
  file(WRITE "${DST}/.stamp" "${source}")
endif()
